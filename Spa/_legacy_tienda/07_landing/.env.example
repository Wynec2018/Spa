# Copia este archivo a .env y ajusta los valores reales.
# No subir .env al repositorio.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# CTA comercial configurable.
# Dejar vacío hasta que el cliente confirme un número real de WhatsApp.
# Nunca inventar un número que parezca real.
LANDING_WHATSAPP=
LANDING_CONTACT_EMAIL=contacto@localhost.com
